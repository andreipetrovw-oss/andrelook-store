generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  RU
  ET
  EN
}

enum PublicationStatus {
  DRAFT
  READY
  PUBLISHED
  ARCHIVED
}

enum AvailabilityType {
  IN_STOCK
  PRE_ORDER
  UNAVAILABLE
}

enum SourceReviewStatus {
  CANDIDATE
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  CONTACTED
  CONFIRMED
  AWAITING_PAYMENT
  PAID
  ORDERED
  IN_TRANSIT
  READY
  DELIVERED
  CANCELLED
}

enum ContactMethod {
  TELEGRAM
  INSTAGRAM
  PHONE
  EMAIL
  OTHER
}

enum AcquisitionChannel {
  DIRECT
  INSTAGRAM
  MARKETPLACE
  ADVERTISING
  REFERRAL
  OTHER
}

enum TrafficSource {
  UNKNOWN
  META_ADS
  GOOGLE_ADS
  INSTAGRAM_ORGANIC
  FACEBOOK_ORGANIC
  TELEGRAM
  GOOGLE_ORGANIC
  BING_ORGANIC
  AI_CHATGPT
  REFERRAL
  DIRECT
  OTHER
  EMAIL
  PARTNER
  MARKETPLACE
}

enum SourceGroup {
  PAID
  ORGANIC
  OWNED
  REFERRAL
  DIRECT
  OTHER
  UNKNOWN
}

enum AttributionTouchType {
  FIRST
  LAST
}

enum BusinessEventType {
  LEAD_CREATED
  LEAD_CONTACTED
  LEAD_CONFIRMED
  AWAITING_PAYMENT
  PAID
  ORDERED
  IN_TRANSIT
  READY
  DELIVERED
  CANCELLED
}

enum CampaignStatus {
  UNKNOWN
  ACTIVE
  PAUSED
  ENDED
}

enum SpendImportSource {
  MANUAL
  CSV
  API
}

enum AnalyticsEventName {
  PAGE_VIEW
  VIEW_ITEM_LIST
  SELECT_ITEM
  VIEW_ITEM
  PREORDER_OPEN
  PREORDER_SUBMIT
}

enum EconomicsSourceType {
  ESTIMATE
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
  REFUND
  ADJUSTMENT
}

enum PaymentStatus {
  ACTIVE
  VOIDED
}

enum FulfilmentMethod {
  PERSONAL_HANDOVER
  DELIVERY
}

enum DeliveryMode {
  PERSONAL_HANDOVER
  ESTONIA_DELIVERY
  INTERNATIONAL_DELIVERY
}

enum ShipmentKind {
  INTERNATIONAL_INBOUND
  LOCAL_OUTBOUND
}

enum ShipmentProvider {
  SEVENTEEN_TRACK
  SHIP24
  LOCAL_CARRIER
  MANUAL
}

enum ShipmentSyncStatus {
  PENDING
  SUCCESS
  FAILURE
  NOT_FOUND
  UNAVAILABLE
}

enum ShipmentStatus {
  ORDER_CONFIRMED
  PREPARING_ORDER
  QUALITY_CHECK_COMPLETE
  HANDED_TO_LOGISTICS
  INTERNATIONAL_TRANSIT
  EUROPEAN_LOGISTICS
  ARRIVED_AT_ANDRELOOK
  READY_FOR_HANDOVER
  LOCAL_CARRIER
  LOCAL_DELIVERY
  DELIVERED
  DELAYED_OR_EXCEPTION
}

enum TrackingEvidenceSource {
  OWNER_CONFIRMED
  OWNER_VERIFIED_LOGISTICS
  WAREHOUSE_CONFIRMED
  PROVIDER_EVENT
  LOCAL_CARRIER_EVENT
  MANUAL_OVERRIDE
}

enum LogisticsEvidenceSourceType {
  OWNER_VERIFIED_LOGISTICS
  SUPPORTED_UPSTREAM_PROVIDER
}

enum LogisticsEvidenceVerificationStatus {
  PENDING_REVIEW
  VERIFIED
  VOIDED
}

enum LogisticsEvidenceEventType {
  LOGISTICS_INSTRUCTION_PROVIDED
  LOGISTICS_INFORMATION_RECEIVED
  MOVING_TO_CARRIER_WAREHOUSE
  INTERNATIONAL_LOGISTICS_ACCEPTED
  AIR_TRANSPORT_HANDOFF
  FLIGHT_BOOKED
  INTERNATIONAL_TRANSIT_STARTED
  ARRIVED_IN_EUROPE
  EUROPE_PROCESSING_AWAITING_CUSTOMS
  ESTIMATED_ARRIVAL
}

enum ShipmentIdentifierRole {
  UPSTREAM_INTERNATIONAL
  PRIMARY_CARRIER
  LOCAL_LAST_MILE
}

enum TrackingEtaSource {
  PROVIDER
  OFFICIAL_CARRIER
  OWNER_CONFIRMED
  OWNER_VERIFIED_LOGISTICS
  SYSTEM_ESTIMATE
}

enum TrackingEtaConfidence {
  LOW
  MEDIUM
  HIGH
}

enum OrderTrackingMilestoneKind {
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  PREPARATION_STARTED
  QUALITY_CHECK_RECEIVED
  QUALITY_CHECK_APPROVED
  PACKING_CONFIRMED
  INTERNATIONAL_DISPATCH_CONFIRMED
}

enum ShipmentRelationship {
  MASTER_INBOUND
  LOCAL_OUTBOUND
  CARRIER_OUTBOUND
}

enum PaymentPreference {
  DEPOSIT_30_BALANCE_ON_HANDOVER
  FULL_ADVANCE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ImageRole {
  PRIMARY
  GALLERY
  SIZE_CHART
  DETAIL
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  parentId     String?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  sortOrder    Int                   @default(0)
  isActive     Boolean               @default(true)
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([parentId, sortOrder])
}

model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale         Locale
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?

  @@unique([categoryId, locale])
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  displayName String
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                   String                    @id @default(cuid())
  internalCode         String                    @unique
  slug                 String?                   @unique
  categoryId           String?
  category             Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId              String?
  brand                Brand?                    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  publicationStatus    PublicationStatus         @default(DRAFT)
  availabilityType     AvailabilityType?
  retailPriceMinor     Int?
  currency             String?                   @db.Char(3)
  preorderEstimateText String?
  isFeatured           Boolean                   @default(false)
  sortOrder            Int                       @default(0)
  publishedAt          DateTime?
  translations         ProductTranslation[]
  privateData          ProductPrivate?
  sourceImages         ProductSourceImage[]
  images               ProductImage[]
  colors               ProductColor[]
  sizeChart            SizeChart?
  variants             ProductVariant[]
  orderItems           OrderItem[]
  economicsVersions    ProductEconomicsVersion[]
  attributedAdSpend    AdSpend[]
  analyticsEvents      AnalyticsEvent[]
  customerReviews      CustomerReview[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([publicationStatus, categoryId, sortOrder])
  @@index([availabilityType])
}

model ProductEconomicsVersion {
  id                      String              @id @default(cuid())
  productId               String
  product                 Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseEstimateMinor   Int
  logisticsEstimateMinor  Int
  landedCostEstimateMinor Int
  retailSnapshotMinor     Int
  paymentRateBps          Int
  targetAdRateBps         Int
  sourceType              EconomicsSourceType @default(ESTIMATE)
  effectiveFrom           DateTime
  version                 Int
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([productId, version])
  @@index([productId, effectiveFrom])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           Locale
  name             String
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?

  @@unique([productId, locale])
}

model ProductPrivate {
  id                            String             @id @default(cuid())
  productId                     String             @unique
  product                       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierName                  String?
  supplierSourceId              String?
  supplierUrl                   String?
  supplierAlbumUrl              String?
  supplierProductCode           String?
  supplierCostMinor             Int?
  supplierCurrency              String?            @db.Char(3)
  landedCostMinor               Int?
  supplierAvailabilityText      String?
  supplierAvailabilityCheckedAt DateTime?
  internalNotes                 String?
  sourceReviewStatus            SourceReviewStatus @default(CANDIDATE)
  sourcePayload                 Json?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
}

model ProductSourceImage {
  id                 String             @id @default(cuid())
  productId          String
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourcePosition     Int
  sourceName         String?
  sourceUrl          String
  previewUrl         String?
  width              Int?
  height             Int?
  isSizeChart        Boolean            @default(false)
  inferredView       String?
  assignedSourceRole String?
  sourceSha256       String?
  localOriginalPath  String?
  httpValidation     Json?
  reviewStatus       SourceReviewStatus @default(CANDIDATE)
  publicAssets       ProductImage[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([productId, sourcePosition])
  @@index([productId, isSizeChart])
}

model ProductImage {
  id            String                    @id @default(cuid())
  productId     String
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceImageId String?
  sourceImage   ProductSourceImage?       @relation(fields: [sourceImageId], references: [id], onDelete: SetNull)
  storageKey    String                    @unique
  url           String
  role          ImageRole
  sortOrder     Int                       @default(0)
  width         Int
  height        Int
  reviewStatus  SourceReviewStatus        @default(NEEDS_REVIEW)
  approvedAt    DateTime?
  translations  ProductImageTranslation[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([productId, role, sortOrder])
  @@index([sourceImageId])
}

model ProductImageTranslation {
  id      String       @id @default(cuid())
  imageId String
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  locale  Locale
  altText String

  @@unique([imageId, locale])
}

model ProductColor {
  id           String                    @id @default(cuid())
  productId    String
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  code         String
  swatchHex    String?
  sortOrder    Int                       @default(0)
  reviewStatus SourceReviewStatus        @default(NEEDS_REVIEW)
  translations ProductColorTranslation[]
  variants     ProductVariant[]

  @@unique([productId, code])
}

model ProductColorTranslation {
  id      String       @id @default(cuid())
  colorId String
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  locale  Locale
  name    String

  @@unique([colorId, locale])
}

model SizeChart {
  id           String             @id @default(cuid())
  productId    String             @unique
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  units        String?
  chartData    Json
  reviewStatus SourceReviewStatus @default(NEEDS_REVIEW)
  isPublished  Boolean            @default(false)
  reviewedAt   DateTime?
  evidence     SizeChartEvidence?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model SizeChartEvidence {
  id                  String    @id @default(cuid())
  sizeChartId         String    @unique
  sizeChart           SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)
  sourceAlbumId       String?
  sourceImagePosition Int?
  sourceImageUrl      String?
  sourceImageSha256   String?
  verification        String?
  verificationDate    DateTime?
  chartScope          String?
  notes               Json?
}

model ProductVariant {
  id            String        @id @default(cuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId       String?
  color         ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  variantKey    String
  sizeLabel     String?
  stockQuantity Int           @default(0)
  isEnabled     Boolean       @default(false)
  ownerSku      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([productId, variantKey])
  @@index([productId, isEnabled])
}

model Customer {
  id                     String        @id @default(cuid())
  name                   String
  preferredContactMethod ContactMethod
  preferredContactValue  String
  phone                  String?
  email                  String?
  telegramHandle         String?
  instagramHandle        String?
  firstName              String?
  lastName               String?
  preferredLocale        Locale
  internalNotes          String?
  orders                 Order[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([preferredContactMethod, preferredContactValue])
}

model Order {
  id                           String                          @id @default(cuid())
  displayNumber                String                          @unique
  requestKey                   String                          @unique
  customerId                   String
  customer                     Customer                        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status                       OrderStatus                     @default(NEW)
  currency                     String?                         @db.Char(3)
  confirmedTotalMinor          Int?
  agreedTotalMinor             Int?
  fulfilmentMethod             FulfilmentMethod?
  deliveryMode                 DeliveryMode?
  paymentPreference            PaymentPreference?
  countryCode                  String?                         @db.Char(2)
  city                         String?
  postalCode                   String?
  addressLine1                 String?
  addressLine2                 String?
  acquisitionChannel           AcquisitionChannel              @default(DIRECT)
  utmSource                    String?
  utmMedium                    String?
  utmCampaign                  String?
  utmContent                   String?
  utmTerm                      String?
  initialReferrer              String?
  landingPath                  String?
  requestedLocale              Locale
  consentVersion               String
  consentAt                    DateTime
  orderDate                    DateTime                        @default(now())
  confirmedAt                  DateTime?
  supplierOrderedAt            DateTime?
  etaText                      String?
  etaDate                      DateTime?
  trackingReference            String?
  publicTrackingToken          String?                         @unique
  trackingAccessCodeHash       String?                         @unique
  trackingAccessCodeEncrypted  String?
  trackingCredentialsRotatedAt DateTime?
  nextActionAt                 DateTime?
  internalNotes                String?
  customerNotes                String?
  cancelledReason              String?
  items                        OrderItem[]
  payments                     Payment[]
  statusHistory                OrderStatusHistory[]
  attribution                  OrderAttribution?
  businessEvents               OrderBusinessEvent[]
  notification                 OrderNotification?
  shipmentLinks                OrderShipment[]
  trackingNotifications        TrackingMilestoneNotification[]
  trackingMilestones           OrderTrackingMilestone[]
  correctionHistory            OrderCorrectionHistory[]
  reviewInvitation             ReviewInvitation?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  @@index([status, nextActionAt])
  @@index([acquisitionChannel, orderDate])
  @@index([customerId, orderDate])
}

enum ReviewStatus {
  SUBMITTED
  PUBLISHED
  REJECTED
  UNPUBLISHED
}

enum ReviewKind {
  SERVICE
  PRODUCT
}

model ReviewInvitation {
  id                String                    @id @default(cuid())
  orderId           String                    @unique
  order             Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tokenHash         String                    @unique
  tokenEncrypted    String
  revokedAt         DateTime?
  requestedAt       DateTime?
  createdAt         DateTime                  @default(now())
  rotatedAt         DateTime?
  review            CustomerReview?
  moderationHistory ReviewModerationHistory[]
}

model CustomerReview {
  id                   String                    @id @default(cuid())
  publicId             String                    @unique @default(uuid())
  invitationId         String                    @unique
  invitation           ReviewInvitation          @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  kind                 ReviewKind                @default(SERVICE)
  productId            String?
  product              Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderItemId          String?                   @unique
  orderItem            OrderItem?                @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productNameSnapshot  String?
  locale               Locale
  rating               Int
  originalText         String
  publicText           String
  displayName          String
  qualityRating        Int?
  communicationRating  Int?
  deliveryRating       Int?
  status               ReviewStatus              @default(SUBMITTED)
  publicationConsentAt DateTime
  submittedAt          DateTime                  @default(now())
  publishedAt          DateTime?
  updatedAt            DateTime                  @updatedAt
  moderationHistory    ReviewModerationHistory[]

  @@index([status, submittedAt])
  @@index([productId, status])
}

model ReviewModerationHistory {
  id           String           @id @default(cuid())
  reviewId     String?
  review       CustomerReview?  @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  invitationId String
  invitation   ReviewInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  actorEmail   String
  action       String
  reason       String?
  previousText String?
  createdAt    DateTime         @default(now())

  @@index([invitationId, createdAt])
}

model ReviewRateLimit {
  keyHash     String   @id
  attempts    Int      @default(1)
  windowStart DateTime

  @@index([windowStart])
}

model Shipment {
  id                           String                          @id @default(cuid())
  kind                         ShipmentKind
  provider                     ShipmentProvider
  fallbackProvider             ShipmentProvider?
  internalTrackingNumber       String                          @unique
  providerTrackingId           String?
  fallbackTrackingId           String?
  detectedCarrierCode          String?
  detectedCarrierName          String?
  fallbackDetectedCarrierCode  String?
  fallbackDetectedCarrierName  String?
  normalizedStatus             ShipmentStatus                  @default(ORDER_CONFIRMED)
  rawStatus                    String?
  fallbackRawStatus            String?
  providerSyncStatus           ShipmentSyncStatus              @default(PENDING)
  providerLastError            String?
  fallbackSyncStatus           ShipmentSyncStatus?
  fallbackLastError            String?
  estimatedDeliveryAt          DateTime?
  etaFrom                      DateTime?
  etaTo                        DateTime?
  etaSource                    TrackingEvidenceSource?
  etaNote                      String?
  etaWindowSource              TrackingEtaSource?
  etaConfidence                TrackingEtaConfidence?
  etaEvidenceNote              String?
  etaConfirmedAt               DateTime?
  lastProviderUpdateAt         DateTime?
  fallbackLastProviderUpdateAt DateTime?
  lastConfirmedEventAt         DateTime?
  lastSyncAt                   DateTime?
  lastSuccessfulSyncAt         DateTime?
  fallbackLastSyncAt           DateTime?
  fallbackLastSuccessfulSyncAt DateTime?
  staleAfterDays               Int                             @default(7)
  staleFlag                    Boolean                         @default(false)
  deliveredAt                  DateTime?
  publicCarrierName            String?
  publicTrackingNumber         String?
  exposePublicTracking         Boolean                         @default(false)
  requiresOwnerReview          Boolean                         @default(false)
  orderLinks                   OrderShipment[]
  events                       TrackingEvent[]
  providerRecords              TrackingProviderRecord[]
  logisticsEvidence            ShipmentLogisticsEvidence[]
  trackingIdentifiers          ShipmentTrackingIdentifier[]
  overrides                    ShipmentStatusOverride[]
  notifications                TrackingMilestoneNotification[]
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  @@index([normalizedStatus, staleFlag])
  @@index([providerSyncStatus, lastSyncAt])
}

model ShipmentLogisticsEvidence {
  id                  String                              @id @default(cuid())
  shipmentId          String
  shipment            Shipment                            @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sourceType          LogisticsEvidenceSourceType
  sourceLabel         String
  eventType           LogisticsEvidenceEventType
  eventTimestamp      DateTime?
  sourceTimestampText String?
  sourceTimeZone      String?
  internalLocation    String?
  evidenceNote        String
  verificationStatus  LogisticsEvidenceVerificationStatus @default(VERIFIED)
  customerVisible     Boolean                             @default(true)
  internalReference   String?
  canonicalKey        String
  revision            Int                                 @default(1)
  supersedesId        String?                             @unique
  supersedes          ShipmentLogisticsEvidence?          @relation("LogisticsEvidenceRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy        ShipmentLogisticsEvidence?          @relation("LogisticsEvidenceRevision")
  createdByAdminId    String
  createdByAdmin      AdminUser                           @relation("LogisticsEvidenceCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt           DateTime                            @default(now())

  @@unique([shipmentId, canonicalKey, revision])
  @@index([shipmentId, eventTimestamp])
  @@index([shipmentId, verificationStatus])
}

model ShipmentTrackingIdentifier {
  id          String                 @id @default(cuid())
  shipmentId  String
  shipment    Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  role        ShipmentIdentifierRole
  provider    ShipmentProvider?
  sourceLabel String
  value       String
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  retiredAt   DateTime?

  @@unique([shipmentId, value])
  @@index([shipmentId, role, isActive])
}

model OrderTrackingMilestone {
  id               String                     @id @default(cuid())
  orderId          String
  order            Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind             OrderTrackingMilestoneKind
  occurredAt       DateTime
  evidenceSource   TrackingEvidenceSource
  evidenceNote     String
  customerVisible  Boolean                    @default(true)
  createdByAdminId String
  createdByAdmin   AdminUser                  @relation("OrderTrackingMilestoneCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime                   @default(now())

  @@index([orderId, occurredAt])
}

model OrderShipment {
  id              String               @id @default(cuid())
  orderId         String
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentId      String
  shipment        Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  relationship    ShipmentRelationship
  sequence        Int                  @default(0)
  customerVisible Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([orderId, shipmentId])
  @@index([shipmentId, sequence])
  @@index([orderId, sequence])
}

model TrackingProviderRecord {
  id               String             @id @default(cuid())
  shipmentId       String
  shipment         Shipment           @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  provider         ShipmentProvider
  providerRecordId String?
  contentHash      String
  syncStatus       ShipmentSyncStatus
  carrierCode      String?
  carrierName      String?
  latestEventAt    DateTime?
  payload          Json
  receivedAt       DateTime           @default(now())

  @@unique([shipmentId, provider, contentHash])
  @@index([shipmentId, receivedAt])
}

model TrackingEvent {
  id               String                 @id @default(cuid())
  shipmentId       String
  shipment         Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  provider         ShipmentProvider?
  providerEventId  String
  evidenceSource   TrackingEvidenceSource
  normalizedStatus ShipmentStatus
  rawStatus        String?
  rawDescription   String?
  rawLocation      String?
  rawTimestamp     DateTime?
  publicTimestamp  DateTime?
  customerVisible  Boolean                @default(true)
  createdByAdminId String?
  createdByAdmin   AdminUser?             @relation("TrackingEventCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())

  @@unique([shipmentId, evidenceSource, providerEventId])
  @@index([shipmentId, rawTimestamp])
  @@index([shipmentId, publicTimestamp])
}

model ShipmentStatusOverride {
  id               String                 @id @default(cuid())
  shipmentId       String
  shipment         Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fromStatus       ShipmentStatus
  toStatus         ShipmentStatus
  evidenceSource   TrackingEvidenceSource
  reason           String
  changedByAdminId String
  changedByAdmin   AdminUser              @relation("ShipmentOverrideCreator", fields: [changedByAdminId], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now())

  @@index([shipmentId, createdAt])
}

model TrackingMilestoneNotification {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentId        String?
  shipment          Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  milestone         ShipmentStatus
  status            NotificationStatus @default(PENDING)
  recipient         String
  provider          String             @default("resend")
  providerMessageId String?
  attempts          Int                @default(0)
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([orderId, shipmentId, milestone])
  @@index([status, updatedAt])
}

model TrackingLookupBucket {
  keyHash     String   @id
  windowStart DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderAttribution {
  id                    String             @id @default(cuid())
  orderId               String             @unique
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attributionWindowDays Int                @default(30)
  consentVersion        String
  analyticsConsent      Boolean            @default(false)
  marketingConsent      Boolean            @default(false)
  websiteSessionId      String?
  capturedAt            DateTime           @default(now())
  touches               AttributionTouch[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([websiteSessionId])
}

model AttributionTouch {
  id                 String               @id @default(cuid())
  orderAttributionId String
  orderAttribution   OrderAttribution     @relation(fields: [orderAttributionId], references: [id], onDelete: Cascade)
  touchType          AttributionTouchType
  source             TrafficSource
  sourceGroup        SourceGroup
  campaignName       String?
  adSetName          String?
  adName             String?
  contentLabel       String?
  landingPage        String?
  referrer           String?
  locale             Locale
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  gclid              String?
  fbclid             String?
  fbp                String?
  fbc                String?
  gaClientId         String?
  gaSessionId        String?
  eventId            String?
  occurredAt         DateTime
  createdAt          DateTime             @default(now())

  @@unique([orderAttributionId, touchType])
  @@index([source, occurredAt])
  @@index([campaignName, occurredAt])
}

model OrderBusinessEvent {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType   BusinessEventType
  eventKey    String            @unique
  amountMinor Int?
  currency    String?           @db.Char(3)
  isActive    Boolean           @default(true)
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([eventType, occurredAt])
  @@index([orderId, occurredAt])
}

model Campaign {
  id                 String              @id @default(cuid())
  source             TrafficSource
  externalCampaignId String?
  campaignName       String
  utmCampaign        String?
  status             CampaignStatus      @default(UNKNOWN)
  startDate          DateTime?
  endDate            DateTime?
  metaSnapshot       Json?
  metaSyncedAt       DateTime?
  currency           String              @default("EUR") @db.Char(3)
  spendEntries       AdSpend[]
  changeLogs         CampaignChangeLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([source, campaignName])
  @@index([source, status])
}

model CampaignChangeLog {
  id                String     @id @default(cuid())
  campaignId        String?
  campaign          Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignName      String
  change            String
  reason            String?
  changedAt         DateTime
  recordedByAdminId String?
  recordedByAdmin   AdminUser? @relation("CampaignChangeRecorder", fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())

  @@index([changedAt])
  @@index([campaignId, changedAt])
}

model AdSpend {
  id                String            @id @default(cuid())
  date              DateTime
  source            TrafficSource
  campaignId        String?
  campaign          Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignName      String?
  productId         String?
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  externalAdSetId   String?
  adSetName         String?
  externalAdId      String?
  adName            String?
  currency          String            @db.Char(3)
  spendMinor        Int
  impressions       Int?
  reach             Int?
  linkClicks        Int?
  outboundClicks    Int?
  landingPageViews  Int?
  importSource      SpendImportSource @default(MANUAL)
  externalRecordId  String?           @unique
  recordedByAdminId String?
  recordedByAdmin   AdminUser?        @relation("SpendRecorder", fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([date, source])
  @@index([campaignId, date])
  @@index([productId, date])
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  eventId      String             @unique
  sessionId    String
  eventName    AnalyticsEventName
  occurredAt   DateTime           @default(now())
  source       TrafficSource
  sourceGroup  SourceGroup
  campaignName String?
  adSetName    String?
  adName       String?
  contentLabel String?
  landingPage  String?
  pagePath     String
  locale       Locale
  productId    String?
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([eventName, occurredAt])
  @@index([source, occurredAt])
  @@index([campaignName, occurredAt])
  @@index([landingPage, occurredAt])
  @@index([productId, occurredAt])
  @@index([sessionId, occurredAt])
}

model AnalyticsDataSourceStatus {
  source           String    @id
  status           String
  lastAttemptAt    DateTime
  lastSuccessAt    DateTime?
  lastImportedRows Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OrderItem {
  id                             String               @id @default(cuid())
  orderId                        String
  order                          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                      String?
  product                        Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  productInternalCodeSnapshot    String
  productNameSnapshot            String
  productSlugSnapshot            String?
  colorSnapshot                  String?
  sizeSnapshot                   String?
  sizeHelpRequested              Boolean              @default(false)
  measurementsNote               String?
  availabilityTypeSnapshot       AvailabilityType?
  quantity                       Int
  unitPriceMinor                 Int?
  unitLandedCostMinorSnapshot    Int?
  unitPurchaseCostMinorSnapshot  Int?
  unitLogisticsCostMinorSnapshot Int?
  paymentRateBpsSnapshot         Int?
  economicsVersionSnapshot       Int?
  economicsSourceTypeSnapshot    EconomicsSourceType?
  internalNotes                  String?
  customerReview                 CustomerReview?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  @@index([orderId])
  @@index([productId])
}

model OrderNotification {
  id                String             @id @default(cuid())
  orderId           String             @unique
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            NotificationStatus @default(PENDING)
  recipient         String
  provider          String
  providerMessageId String?
  attempts          Int                @default(0)
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, updatedAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind              PaymentKind
  status            PaymentStatus @default(ACTIVE)
  amountMinor       Int
  processorFeeMinor Int?
  currency          String        @db.Char(3)
  receivedAt        DateTime
  reference         String?
  internalNotes     String?
  recordedByAdminId String?
  recordedByAdmin   AdminUser?    @relation("PaymentRecorder", fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  voidedAt          DateTime?
  voidReason        String?
  voidedByAdminId   String?
  voidedByAdmin     AdminUser?    @relation("PaymentVoider", fields: [voidedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())

  @@index([orderId, receivedAt])
  @@index([orderId, status])
}

model OrderCorrectionHistory {
  id               String     @id @default(cuid())
  orderId          String
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedField     String
  previousValue    Json?
  newValue         Json?
  changedByAdminId String?
  changedByAdmin   AdminUser? @relation("OrderCorrectionActor", fields: [changedByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())

  @@index([orderId, createdAt])
}

model OrderStatusHistory {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus       OrderStatus?
  toStatus         OrderStatus
  changedByAdminId String?
  changedByAdmin   AdminUser?   @relation("StatusChanger", fields: [changedByAdminId], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime     @default(now())

  @@index([orderId, createdAt])
}

model AdminUser {
  id                      String                      @id @default(cuid())
  provider                String
  providerSubject         String
  email                   String                      @unique
  isActive                Boolean                     @default(true)
  payments                Payment[]                   @relation("PaymentRecorder")
  voidedPayments          Payment[]                   @relation("PaymentVoider")
  orderCorrections        OrderCorrectionHistory[]    @relation("OrderCorrectionActor")
  statusChanges           OrderStatusHistory[]        @relation("StatusChanger")
  spendEntries            AdSpend[]                   @relation("SpendRecorder")
  campaignChanges         CampaignChangeLog[]         @relation("CampaignChangeRecorder")
  trackingEvents          TrackingEvent[]             @relation("TrackingEventCreator")
  shipmentOverrides       ShipmentStatusOverride[]    @relation("ShipmentOverrideCreator")
  orderTrackingMilestones OrderTrackingMilestone[]    @relation("OrderTrackingMilestoneCreator")
  logisticsEvidence       ShipmentLogisticsEvidence[] @relation("LogisticsEvidenceCreator")
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@unique([provider, providerSubject])
}
