# PostgreSQL. Use a development/staging database only in Phase 6B.
DATABASE_URL="postgresql://andrelook:change-me@localhost:5432/andrelook_v1?schema=public"

# Public staging origin used to construct canonical and alternate URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
INDEXING_ENABLED="false"

# Authentication is deliberately fail-closed until the owner chooses/configures
# a provider and allowlisted identity. Supported current value: clerk.
AUTH_PROVIDER="disabled"
OWNER_EMAILS=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
