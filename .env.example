# PostgreSQL. Use a development/staging database only in Phase 6B.
DATABASE_URL="postgresql://andrelook:change-me@localhost:5432/andrelook_v1?schema=public"

# Public staging origin used to construct canonical and alternate URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MEASUREMENT_ENABLED="false"
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
CRM_URL=""
INDEXING_ENABLED="false"

# Owner review only. Remote review additionally requires STAGING_REVIEW_PROJECT_ID
# to exactly match Vercel's automatic VERCEL_PROJECT_ID and deployment protection.
STOREFRONT_REVIEW_MODE="false"
STAGING_REVIEW_PROJECT_ID=""

# Authentication is deliberately fail-closed until the owner chooses/configures
# a provider and allowlisted identity. Supported current value: clerk.
AUTH_PROVIDER="disabled"
OWNER_EMAILS=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Server-only operational order alert. The database record remains authoritative
# if delivery fails. Never expose the API key through NEXT_PUBLIC_*.
RESEND_API_KEY=""
ORDER_NOTIFICATION_FROM="Andrelook Orders <orders@andrelook.store>"
ORDER_NOTIFICATION_TO="info.andrelook@gmail.com"
