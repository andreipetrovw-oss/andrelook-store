{
  "name": "andrelook-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migration:script": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:migrate:deploy": "prisma migrate deploy",
    "import:phase5": "tsx scripts/import-phase5c1.ts",
    "seed:phase6c": "tsx scripts/seed-phase6c-review.ts",
    "postinstall": "prisma generate",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run db:validate && npm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.7",
    "@prisma/client": "^6.12.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prisma": "^6.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
